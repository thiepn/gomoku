ne.',rule:'After urgent tactics are handled, prefer intersections that participate in more than one useful direction.',skill:'crossing'},
 {id:'checkpoint',title:'Chapter checkpoint',lead:'Now run the scan without being told which skill is being tested. These positions mix wins, blocks, live lines and multi-direction vision.',rule:'Do not guess. Run the same scan every time: win → defend → force → improve.',skill:'mixed',checkpoint:true}
];

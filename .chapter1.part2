te(-50%,-50%);width:72%;height:72%;border-radius:50%;box-shadow:0 2px 4px #0004}.ch1-stone.black{background:radial-gradient(circle at 34% 28%,#5a554d,#181713 66%,#050505)}.ch1-stone.white{background:radial-gradient(circle at 34% 28%,#fff,#e7dfd2 68%);border:1px solid #9d907d}.ch1-cell.choice::marker{display:none}.ch1-cell.choice{border-radius:50%;outline:2px solid color-mix(in srgb,var(--seal) 55%,transparent);outline-offset:-7px}.ch1-choice-label{position:absolute;z-index:4;inset:auto 3px 2px auto;width:15px;height:15px;display:grid;place-items:center;border-radius:50%;background:var(--seal);color:white;font:800 7px system-ui}.ch1-cell.wrong{animation:ch1Wrong .22s ease}.ch1-cell.correct{background:radial-gradient(circle,color-mix(in srgb,var(--seal) 25%,transparent) 0 26%,transparent 29%)}.ch1-cell.revealed{background:radial-gradient(circle,color-mix(in srgb,#2e7b50 30%,transparent) 0 26%,transparent 29%)}@keyframes ch1Wrong{0%,100%{transform:translateX(0)}35%{transform:translateX(-3px)}70%{transform:translateX(3px)}}
.ch1-task-copy h4{font:600 18px Georgia,serif;margin:0 0 7px}.ch1-task-copy>p{font-size:10px;line-height:1.62;color:var(--ink2);margin:0}.ch1-hint{min-height:38px;margin-top:10px;padding:9px 10px;border-radius:7px;background:var(--paper);font-size:9px;line-height:1.5;color:var(--ink2)}.ch1-hint.good{color:#246642;border-left:3px solid #347a55}.ch1-hint.bad{color:var(--seal);border-left:3px solid var(--seal)}.ch1-task-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}.ch1-task-actions button{min-height:39px}.ch1-lesson-done{margin-top:16px;padding:15px;border:1px solid color-mix(in srgb,var(--seal) 24%,var(--hair));border-radius:9px;background:var(--soft)}.ch1-lesson-done h4{font:600 18px Georgia,serif;margin:0 0 5px}.ch1-lesson-done p{font-size:9px;line-height:1.55;color:var(--ink2)}.ch1-skill-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:11px}.ch1-skill{padding:9px;border:1px solid var(--hair);border-radius:7px;background:var(--card2)}.ch1-skill b{display:flex;justify-content:space-between;gap:8px;font-size:8px}.ch1-skill span{display:block;height:4px;background:var(--hair);border-radius:999px;margin-top:7px;overflow:hidden}.ch1-skill i{display:block;height:100%;background:var(--seal);border-radius:inherit}.ch1-skill small{display:block;margin-top:5px;color:var(--ink2);font-size:7px}.ch1-chapter-finish{padding:18px;border:1px solid var(--hair);border-radius:10px;background:linear-gradient(135deg,var(--card),var(--soft));margin-top:18px}.ch1-chapter-finish h4{font:600 22px Georgia,serif}.ch1-chapter-finish p{margin-top:6px;color:var(--ink2);font-size:10px;line-height:1.6}

@media(max-width:760px){
 #ch1CourseCard{margin:11px 0;padding:13px}.ch1-card-copy h3{font-size:18px}.ch1-progress-ring{width:50px;height:50px}.ch1-card-meta{grid-template-columns:1fr 1fr}.ch1-card-meta>div:last-child{grid-column:1/-1}
 #ch1CourseDialog{width:100vw;max-width:none;height:100dvh;max-height:100dvh;border:0;border-radius:0;margin:0}.ch1-shell{height:100dvh;max-height:none}.ch1-head{padding:12px 13px}.ch1-head h2{font-size:21px}.ch1-head p{font-size:8px}.ch1-body{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}.ch1-nav{display:flex;gap:5px;border-right:0;border-bottom:1px solid var(--hair);padding:7px;overflow:auto}.ch1-nav-summary{display:none}.ch1-nav button{flex:0 0 118px;grid-template-columns:22px 1fr;padding:7px;min-height:43px}.ch1-step-score{display:none}.ch1-step-copy span{display:none}.ch1-main{padding:15px 12px calc(22px + env(safe-area-inset-bottom))}.ch1-main h3{font-size:23px}.ch1-lead{font-size:10px}.ch1-scan{grid-template-columns:1fr 1fr}.ch1-work{grid-template-columns:1fr;gap:13px}.ch1-board{--cell:min(9.6vw,42px);padding:6px}.ch1-task-card{padding:11px}.ch1-task-copy h4{font-size:17px}.ch1-skill-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:390px){.ch1-card-meta{grid-template-columns:1fr}.ch1-card-meta>div:last-child{grid-column:auto}.ch1-board{--cell:9.25vw}.ch1-skill-grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.ch1-cell.wrong{animation:none!important}}
</style>

<script id="course-ch1-v1-script">
(()=>{'use strict';
const $=id=>document.getElementById(id),KEY='gomoku.course.chapter1.v1',N=9,p=(x,y)=>y*N+x,now=()=>Date.now();
const SKILLS={
 directions:'Four directions',
 wins:'Winning points',
 defense:'Immediate defense',
 priority:'Move priority',
 space:'Live lines',
 crossing:'Multi-direction vision'
};
const L=[
 {id:'directions',title:'See the four directions',lead:'Every useful scan starts with the same geometry: horizontal, vertical and the two diagonals. Learn to see a line before you calculate anything.',rule:'A five can run in four directions. Before moving, sweep all four through the important stones.',skill:'directions'},
 {id:'wins',title:'Find the winning point',lead:'Do not search for a clever move while a win is already on the board. Learn to recognize endpoints and internal gaps that complete five.',rule:'First question: Can I win right now? Check every line for one empty point that completes five.',skill:'wins'},
 {id:'defense',title:'See their win too',lead:'Board vision must work for both colors. If you cannot win immediately, the next scan is the opponent’s immediate winning point.',rule:'Second question: Can they win next move? If yes, answer that threat before starting a slower plan.',skill:'defense'},
 {id:'priority',title:'Use the scan order',lead:'Strong players reduce the board before comparing strategic ideas. Immediate wins and losses come before development.',rule:'Use this order: win now → stop their win → create a forcing threat → improve your shape.',skill:'priority'},
 {id:'space',title:'Read live and blocked space',lead:'A row of stones is not useful just because it is long. Opponent stones and the board edge restrict where that line can still grow.',rule:'Trace the line into empty space. A stone behind an opponent blocker cannot continue that line.',skill:'space'},
 {id:'crossing',title:'See more than one direction',lead:'An intersection can belong to several lines at once. Efficient moves often improve two directions instead of only o
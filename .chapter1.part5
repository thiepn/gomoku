se,lastWrong=-1;

function mount(){
 if($('#ch1CourseCard'))return;
 const home=$('v92ImproveHome');if(!home){setTimeout(mount,80);return;}
 const card=document.createElement('section');card.id='ch1CourseCard';card.innerHTML='<div class="ch1-card-head"><div class="ch1-card-copy"><span class="ch1-kicker">COURSE · CHAPTER 1</span><h3>Seeing the Board</h3><p>Build the scan you should run before every move: see the four directions, find immediate wins, spot urgent defense and use intersections efficiently.</p></div><div class="ch1-progress-ring" id="ch1Ring"><span id="ch1RingText">0/7</span></div></div><div class="ch1-card-meta"><div><b id="ch1MetaLessons">0 / 7</b><span>steps complete</span></div><div><b id="ch1MetaAccuracy">—</b><span>first-try accuracy</span></div><div><b id="ch1MetaNext">Four directions</b><span>next lesson</span></div></div><div class="ch1-card-actions"><button class="v92-primary" id="ch1Start">Start Chapter 1</button><button class="v92-secondary" id="ch1Review">Review chapter</button></div>';
 const path=$('v112LearnPath'),intro=home.querySelector('.v92-page-intro');(path||intro)?.insertAdjacentElement('afterend',card);
 $('#ch1Start').onclick=()=>openCourse(nextLesson());$('#ch1Review').onclick=()=>openCourse(weakestLesson());
 const h=intro?.querySelector('h2'),pp=intro?.querySelector('p:last-child');if(h)h.textContent='Learn Gomoku, then learn from your games';if(pp)pp.textContent='Start with the course to build board vision. Reviews and practice then turn your real games into targeted improvement.';
 renderCard();
 window.GomokuCourseChapter1=Object.freeze({version:'1.0',open:()=>openCourse(nextLesson()),report});
}
function nextLesson(){const i=L.findIndex((_,k)=>!lessonReport(k).complete);return i<0?L.length-1:i}
function weakestLesson(){
 const candidates=L.slice(0,-1).map((_,i)=>({i,...lessonReport(i)})).filter(x=>x.attempted);
 if(!candidates.length)return 0;candidates.sort((a,b)=>(a.rate??1)-(b.rate??1)||a.i-b.i);return candidates[0].i;
}
function renderCard(){
 const card=$('ch1CourseCard');if(!card)return;const r=report(),n=nextLesson(),progress=Math.round(r.completedLessons/r.totalLessons*100);
 $('#ch1Ring').style.setProperty('--ch1-pct',progress+'%');$('#ch1RingText').textContent=r.completedLessons+'/'+r.totalLessons;$('#ch1MetaLessons').textContent=r.completedLessons+' / '+r.totalLessons;$('#ch1MetaAccuracy').textContent=pct(r.firstTryRate);$('#ch1MetaNext').textContent=r.complete?'Chapter complete':L[n].title;$('#ch1Start').textContent=r.complete?'Open Chapter 1':r.taskAttempts?'Continue Chapter 1':'Start Chapter 1';$('#ch1Review').disabled=!r.taskAttempts;
}
function ensureDialog(){
 if(dialog)return dialog;dialog=document.createElement('dialog');dialog.id='ch1CourseDialog';dialog.setAttribute('aria-labelledby','ch1DialogTitle');dialog.innerHTML='<div class="ch1-shell"><header class="ch1-head"><div><span class="ch1-kicker">GOMOKU COURSE · CHAPTER 1</span><h2 id="ch1DialogTitle">Seeing the Board</h2><p>Build a reliable scan before learning deeper fours, threes and forcing sequences.</p></div><button class="ch1-close" id="ch1Close" aria-label="Close Chapter 1">×</button></header><div class="ch1-body"><nav class="ch1-nav" id="ch1Nav" aria-label="Chapter 1 lessons"></nav><main class="ch1-main" id="ch1Main"></main></div></div>';document.body.append(dialog);$('#ch1Close').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});return dialog;
}
function openCourse(li=0){ensureDialog();S.lesson=Math.max(0,Math.min(L.length-1,li));save();renderCourse();if(!dialog.open)dialog.showModal();}
function renderNav(){
 const nav=$('ch1Nav'),r=report();nav.replaceChildren();const sum=document.createElement('div');sum.className='ch1-nav-summary';sum.innerHTML='<b>'+r.completedLessons+' / '+r.totalLessons+' complete</b><span>First-try accuracy '+pct(r.firstTryRate)+'. Lessons stay unlocked; the score is guidance, not a gate.</span>';nav.append(sum);
 L.forEach((l,i)=>{const lr=lessonReport(i),b=document.createElement('button');b.type='button';b.className=lr.complete?'done':'';b.setAttribute('aria-current',i===S.lesson?'step':'false');b.innerHTML='<span class="ch1-step-num">'+(lr.complete?'✓':i+1)+'</span><span class="ch1-step-copy"><b>'+l.title+'</b><span>'+lr.done+' / '+lr.total+' positions</span></span><span class="ch1-step-score">'+pct(lr.rate)+'</span>';b.onclick=()=>{S.lesson=i;save();renderCourse();};nav.append(b);});
}
function renderCourse(){
 if(!dialog)return;renderNav();const li=S.lesson,l=L[li],ts=tasksFor(li),lr=lessonReport(li),main=$('ch1Main'),cursor=Math.max(0,Math.min(ts.length-1,Number(S.cursor[l.id])||0));selected=-1;revealed=false;lastWrong=-1;
 main.innerHTML='<span class="ch1-breadcrumb">CHAPTER 1 · LESSON '+(li+1)+'</span><h3>'+l.title+'</h3><p class="ch1-lead">'+l.lead+'</p><div class="ch1-rule"><b>Key idea:</b> '+l.rule+'</div>'+(li===3||li===6?'<div class="ch1-scan"><div><b>1 · WIN</b><span>Can I end the game now?</span></div><div><b>2 · DEFEND</b><span>Can they win next move?</span></div><div><b>3 · FORCE</b><span>Can I create an urgent threat?</span></div><div><b>4 · IMPROVE</b><span>Which move helps several directions?</span></div></div>':'')+'<div id="ch1TaskHost"></div><div id="ch1LessonDone"></div>';
 if(lr.complete)renderLessonDone(li);else renderTask(li,cursor);
}
function renderTask(li,ti){
 const l=L[li],ts=tasksFor(li),t=ts[ti];S.cursor[l.id]=ti;save();const r=rec(t.id),host=$('ch1TaskHost');revealed=false;selected=-1;lastWrong=-1;
 host.innerHTML='<section class="ch1-task-card"><div class="ch1-task-top"><div><small>'+(l.checkpoint?'CHECKPOINT':'GUIDED PRACTICE')+'</small><b>'+t.title+'</b></div><span class="ch1-task-count">'+(ti+1)+' / '+ts.length+'</span></div><div class="ch1-work"><div class="ch1-board-wrap"><div class="ch1-board" id="ch1Board" role="grid" aria-label="'+t.title+'" aria-rowcount="9" aria-colcount="9"></div></div><div class="ch1-task-copy"><h4>'+t.prompt+'</h4><p>'+(t.choices?'Only the marked candidate points are choices.':'Tap the intersection you would play.')+'</p><div class="ch1-hint" id="ch1Feedback">Run the scan before you tap.</div><div class="ch1-task-actions"
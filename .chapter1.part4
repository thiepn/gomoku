scan returns nothing, run the opponent win scan.'),
  task('p5','priority','The scan saves time','Choose the move that ends the game instead of improving a different line.',[st(1,0,2),st(2,1,1),st(3,2,1),st(4,3,1),st(5,4,1),st(2,6,1),st(3,6,1),st(4,6,1),st(6,6,2)],[p(6,5)],'The diagonal has an immediate fifth stone. Development on the lower row is irrelevant once a win exists.','Do not compare strategic candidates until urgent tactics are cleared.')
 ],
 space:[
  task('s1','space','Follow the open side','Which marked point continues the existing horizontal line into open space?',[st(2,4,2),st(3,4,1),st(4,4,1)],[p(5,4)],'The white stone blocks growth to the left, so the live continuation is on the right.','A blocker ends that direction of the row.',[p(5,4),p(1,4)]),
  task('s2','space','Vertical open side','Which marked point extends the vertical chain away from the blocker?',[st(4,2,2),st(4,3,1),st(4,4,1)],[p(4,5)],'The upper side is closed by White. The line can still grow downward.','Trace the line away from the opponent stone.',[p(4,5),p(4,1)]),
  task('s3','space','Diagonal open side','Choose the marked continuation that remains on the live diagonal.',[st(2,2,2),st(3,3,1),st(4,4,1)],[p(5,5)],'The down-right side stays open; the opposite side is blocked.','Keep following the same diagonal through empty space.',[p(5,5),p(1,1)]),
  task('s4','space','Do not play behind the wall','Which candidate is actually connected to the active line?',[st(6,2,2),st(5,3,1),st(4,4,1)],[p(3,5)],'White cuts off the upper-right side. The lower-left candidate is the live continuation.','Opponent stones divide lines into separate regions.',[p(3,5),p(7,1)])
 ],
 crossing:[
  task('x1','crossing','The crossing point','Which marked move strengthens two Black directions at once?',[st(4,2,1),st(4,3,1),st(2,4,1),st(3,4,1)],[p(4,4)],'The center candidate belongs to both the vertical and horizontal Black lines.','Look for the intersection shared by both lines.',[p(4,4),p(5,4)]),
  task('x2','crossing','Horizontal + diagonal','Choose the point that belongs to two Black lines.',[st(2,4,1),st(3,4,1),st(3,3,1),st(2,2,1)],[p(4,4)],'Playing at the crossing extends the horizontal row and the down-right diagonal simultaneously.','Find where the two directions meet.',[p(4,4),p(1,4)]),
  task('x3','crossing','Vertical + diagonal','Which candidate participates in both structures?',[st(5,2,1),st(5,3,1),st(3,2,1),st(4,3,1)],[p(5,4)],'The lower point continues the vertical line and the diagonal from the upper-left stones.','Trace both lines until they share an empty point.',[p(5,4),p(5,1)]),
  task('x4','crossing','Efficient intersection','Choose the move that works in two directions rather than only one.',[st(2,5,1),st(3,5,1),st(2,3,1),st(3,4,1)],[p(4,5)],'This point extends the horizontal pair and completes the diagonal connection through the center.','A useful intersection can belong to two candidate lines.',[p(4,5),p(1,5)])
 ]
};
function transform(t,mode,id){
 const f=([x,y,c])=>{let a=x,b=y;if(mode==='r90')[a,b]=[N-1-y,x];else if(mode==='r180')[a,b]=[N-1-x,N-1-y];else if(mode==='mx')[a,b]=[N-1-x,y];else if(mode==='my')[a,b]=[x,N-1-y];return[a,b,c]};
 const fp=i=>{const x=i%N,y=Math.floor(i/N),[a,b]=f([x,y,0]);return p(a,b)};
 return {...t,id,stones:t.stones.map(f),answers:t.answers.map(fp),choices:t.choices?.map(fp)};
}
const CHECKPOINT=[
 transform(LESSON_TASKS.wins[0],'r90','c1'),
 transform(LESSON_TASKS.defense[2],'mx','c2'),
 transform(LESSON_TASKS.priority[0],'r180','c3'),
 transform(LESSON_TASKS.space[1],'mx','c4'),
 transform(LESSON_TASKS.crossing[0],'r90','c5'),
 transform(LESSON_TASKS.wins[4],'my','c6'),
 transform(LESSON_TASKS.defense[0],'r90','c7'),
 transform(LESSON_TASKS.priority[3],'mx','c8'),
 transform(LESSON_TASKS.space[2],'r180','c9'),
 transform(LESSON_TASKS.crossing[1],'my','c10'),
 transform(LESSON_TASKS.directions[3],'mx','c11'),
 transform(LESSON_TASKS.priority[2],'r90','c12')
];
LESSON_TASKS.checkpoint=CHECKPOINT;

function load(){try{const x=JSON.parse(localStorage.getItem(KEY)||'{}');return x&&typeof x==='object'?x:{}}catch{return{}}}
let S=load();S.tasks=S.tasks&&typeof S.tasks==='object'?S.tasks:{};S.lesson=Number.isInteger(S.lesson)?Math.max(0,Math.min(L.length-1,S.lesson)):0;S.cursor=S.cursor&&typeof S.cursor==='object'?S.cursor:{};S.attemptLog=Array.isArray(S.attemptLog)?S.attemptLog.slice(-500):[];
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch{};renderCard();try{window.dispatchEvent(new CustomEvent('gomoku:course-progress',{detail:report()}))}catch{}}
function tasksFor(li){return LESSON_TASKS[L[li].id]||[]}
function rec(id){return S.tasks[id]||{attempts:0,correct:false,firstTry:null,assisted:false}}
function lessonReport(li){
 const ts=tasksFor(li),rows=ts.map(t=>rec(t.id)),done=rows.filter(r=>r.correct).length,clean=rows.filter(r=>r.firstTry===true).length,attempted=rows.filter(r=>r.attempts>0||r.correct).length;
 return {total:ts.length,done,complete:done===ts.length,clean,attempted,rate:attempted?clean/attempted:null};
}
function skillReport(){
 const out={};for(const [key,label] of Object.entries(SKILLS)){const ts=Object.values(LESSON_TASKS).flat().filter(t=>t.skill===key),uniq=[...new Map(ts.map(t=>[t.id,t])).values()],rows=uniq.map(t=>rec(t.id)),attempted=rows.filter(r=>r.attempts>0||r.correct),clean=attempted.filter(r=>r.firstTry===true);out[key]={label,total:uniq.length,attempted:attempted.length,clean:clean.length,rate:attempted.length?clean.length/attempted.length:null};}return out;
}
function report(){
 const lessons=L.map((x,i)=>({...x,...lessonReport(i)})),done=lessons.filter(x=>x.complete).length,base=lessons.slice(0,-1),checkpoint=lessons.at(-1),skills=skillReport();
 const attempted=Object.values(S.tasks).filter(r=>r?.attempts>0||r?.correct),clean=attempted.filter(r=>r?.firstTry===true);
 return {version:'1.0',chapter:1,title:'Seeing the Board',lessons,completedLessons:done,totalLessons:L.length,taskAttempts:attempted.length,firstTryRate:attempted.length?clean.length/attempted.length:null,checkpoint:checkpoint.rate,complete:done===L.length,skills};
}
function pct(v){return v==null?'—':Math.round(v*100)+'%'}
let dialog=null,selected=-1,revealed=fal
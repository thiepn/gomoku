<style id="course-ch1-v1-style">
/* Chapter 1 · Seeing the Board — first structured Gomoku course chapter. */
#ch1CourseCard{margin:14px 0;padding:16px;border:1px solid var(--hair);border-radius:10px;background:linear-gradient(135deg,color-mix(in srgb,var(--card) 94%,transparent),color-mix(in srgb,var(--soft) 45%,var(--card)));position:relative;overflow:hidden}
#ch1CourseCard::after{content:'五';position:absolute;right:14px;top:3px;font:600 74px/1 Georgia,serif;color:color-mix(in srgb,var(--seal) 8%,transparent);pointer-events:none}
.ch1-card-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;position:relative;z-index:1}.ch1-card-copy{min-width:0}.ch1-kicker{display:block;color:var(--seal);font-size:8px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}.ch1-card-copy h3{font:600 21px/1.18 Georgia,serif;margin:5px 0}.ch1-card-copy p{max-width:560px;color:var(--ink2);font-size:10px;line-height:1.6;margin:0}.ch1-progress-ring{flex:none;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--seal) var(--ch1-pct,0%),var(--hair) 0);position:relative}.ch1-progress-ring::before{content:'';position:absolute;inset:5px;border-radius:50%;background:var(--card)}.ch1-progress-ring span{position:relative;z-index:1;font:700 11px system-ui}.ch1-card-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:13px;position:relative;z-index:1}.ch1-card-meta>div{padding:8px 9px;border:1px solid var(--hair);border-radius:7px;background:color-mix(in srgb,var(--card2) 84%,transparent)}.ch1-card-meta b{display:block;font-size:11px}.ch1-card-meta span{display:block;margin-top:2px;color:var(--ink2);font-size:7px;letter-spacing:.06em;text-transform:uppercase}.ch1-card-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px;position:relative;z-index:1}.ch1-card-actions button{min-height:40px}

#ch1CourseDialog{width:min(980px,calc(100vw - 24px));max-height:min(94dvh,920px);padding:0;overflow:hidden;border:1px solid var(--hair2);border-radius:14px;background:var(--paper);color:var(--ink)}
#ch1CourseDialog::backdrop{background:#17130d66;backdrop-filter:blur(3px)}
.ch1-shell{display:grid;grid-template-rows:auto minmax(0,1fr);max-height:min(94dvh,920px)}.ch1-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;padding:17px 19px 14px;border-bottom:1px solid var(--hair);background:var(--paper)}.ch1-head h2{font:600 25px/1.15 Georgia,serif;margin:3px 0 4px}.ch1-head p{color:var(--ink2);font-size:9px;line-height:1.55;max-width:650px;margin:0}.ch1-close{width:42px;height:42px;flex:none;border:1px solid var(--hair);border-radius:8px;background:transparent;color:var(--ink);font-size:24px}.ch1-body{display:grid;grid-template-columns:225px minmax(0,1fr);min-height:0}.ch1-nav{padding:13px;border-right:1px solid var(--hair);overflow:auto;background:color-mix(in srgb,var(--card) 54%,var(--paper))}.ch1-nav-summary{padding:9px 9px 11px;border-bottom:1px solid var(--hair);margin-bottom:7px}.ch1-nav-summary b{display:block;font:600 15px Georgia,serif}.ch1-nav-summary span{display:block;margin-top:4px;color:var(--ink2);font-size:8px;line-height:1.45}.ch1-nav button{width:100%;display:grid;grid-template-columns:25px minmax(0,1fr) auto;gap:7px;align-items:center;text-align:left;border:0;background:transparent;color:var(--ink);padding:9px 8px;border-radius:7px;min-height:48px}.ch1-nav button:hover{background:var(--card2)}.ch1-nav button[aria-current="step"]{background:var(--soft)}.ch1-step-num{width:24px;height:24px;display:grid;place-items:center;border:1px solid var(--hair);border-radius:50%;font-size:8px;font-weight:750}.ch1-nav button.done .ch1-step-num{background:var(--seal);border-color:var(--seal);color:white}.ch1-step-copy b{display:block;font-size:9px}.ch1-step-copy span{display:block;margin-top:2px;color:var(--ink2);font-size:7px;line-height:1.3}.ch1-step-score{font-size:7px;color:var(--ink2);white-space:nowrap}
.ch1-main{overflow:auto;padding:20px 22px 24px}.ch1-breadcrumb{color:var(--seal);font-size:7px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.ch1-main h3{font:600 27px/1.12 Georgia,serif;margin:6px 0 7px}.ch1-lead{max-width:690px;color:var(--ink2);font-size:11px;line-height:1.68}.ch1-rule{margin:14px 0;padding:11px 13px;border-left:3px solid var(--seal);border-radius:0 7px 7px 0;background:var(--card);font-size:10px;line-height:1.55}.ch1-scan{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin:13px 0}.ch1-scan div{padding:8px;border:1px solid var(--hair);border-radius:7px;background:var(--card2)}.ch1-scan b{display:block;color:var(--seal);font-size:8px}.ch1-scan span{display:block;margin-top:3px;font-size:8px;line-height:1.35;color:var(--ink2)}
.ch1-task-card{margin-top:17px;padding:14px;border:1px solid var(--hair);border-radius:10px;background:var(--card)}.ch1-task-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:11px}.ch1-task-top small{display:block;color:var(--ink2);font-size:7px;letter-spacing:.12em;font-weight:800}.ch1-task-top b{display:block;margin-top:3px;font-size:12px}.ch1-task-count{font-size:8px;color:var(--ink2);white-space:nowrap}.ch1-work{display:grid;grid-template-columns:minmax(300px,430px) minmax(210px,1fr);gap:18px;align-items:center}.ch1-board-wrap{display:grid;place-items:center}.ch1-board{--cell:min(42px,5.6vw);display:grid;grid-template-columns:repeat(9,var(--cell));grid-template-rows:repeat(9,var(--cell));padding:9px;border:1px solid #967044;border-radius:9px;background:#d7ad68;box-shadow:inset 0 0 25px #81542424;touch-action:manipulation}.ch1-cell{appearance:none;position:relative;width:var(--cell);height:var(--cell);min-width:0;min-height:0;padding:0;border:0;background:transparent;color:#6a2118;cursor:pointer}.ch1-cell::before,.ch1-cell::after{content:'';position:absolute;pointer-events:none;background:#71533380}.ch1-cell::before{left:0;right:0;top:50%;height:1px}.ch1-cell::after{top:0;bottom:0;left:50%;width:1px}.ch1-cell:disabled{cursor:default;opacity:.58}.ch1-cell.occupied:disabled{opacity:1}.ch1-stone{position:absolute;z-index:2;left:50%;top:50%;transform:transla